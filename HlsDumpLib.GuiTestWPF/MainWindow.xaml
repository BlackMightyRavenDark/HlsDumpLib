<Window x:Class="HlsDumpLib.GuiTestWPF.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:HlsDumpLib.GuiTestWPF"
		mc:Ignorable="d"
		local:AutoBindEvents.IsAutoBindEvent="True"
		Title="GUI test (WPF)"
		Width="720" Height="420" MinWidth="720" MinHeight="400">
	<Window.DataContext>
		<local:ViewModelMainWindow />
	</Window.DataContext>

	<Window.Resources>
		<Style x:Key="menuTextBlock" TargetType="TextBox">
			<Setter Property="ContextMenu">
				<Setter.Value>
					<ContextMenu>
						<MenuItem Header="Удалить" Command="EditingCommands.Delete" />
						<MenuItem Header="Вырезать" Command="Cut" />
						<MenuItem Header="Копировать" Command="Copy" />
						<MenuItem Header="Вставить" Command="Paste" />
						<Separator />
						<MenuItem Header="Выбрать всё" Command="SelectAll" />
					</ContextMenu>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="4 0">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Label Content="Папка для скачивания:" Grid.Row="0" Grid.Column="0" />
				<Label Content="Название (необязательно):"
					   ToolTip="Оставьте поле пустым, чтобы дать название 'untitled'"
					   Grid.Row="1" Grid.Column="0" />
				<Label Content="Ссылка на плейлист:" Grid.Row="2" Grid.Column="0" />

				<Grid Grid.Row="0" Grid.Column="1">
					<Grid.ColumnDefinitions>
						<ColumnDefinition />
						<ColumnDefinition Width="30" />
					</Grid.ColumnDefinitions>

					<TextBox Grid.Row="0" Grid.Column="0" Text="{Binding DownloadDir}" VerticalContentAlignment="Center" Margin="0 4 4 4" Style="{StaticResource menuTextBlock}" />
					<Button Grid.Row="0" Grid.Column="1" Content="..." ToolTip="Выбрать папку..." Margin="4 4 0 4"
							Command="{Binding BtnSelectDownloadDirCommand}" />
				</Grid>

				<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StreamTitle}" VerticalContentAlignment="Center" Margin="0 4" Style="{StaticResource menuTextBlock}" />
				<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StreamPlaylistUrl}" VerticalContentAlignment="Center" Margin="0 4" Style="{StaticResource menuTextBlock}" />
			</Grid>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto" />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition />
					<RowDefinition />
					<RowDefinition />
				</Grid.RowDefinitions>

				<Label Content="Частота проверки плейлиста:" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center"/>
				<Label Content="Максимум ошибок плейлиста подряд:" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" />
				<Label Content="Максимум других ошибок подряд:" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" />

				<StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
					<local:NumericUpDown MaxValue="5000" MinValue="500"
										 Value="{Binding PlaylistCheckIntervalMilliseconds, Mode=TwoWay}"
										 StepSize="100" Width="60" Margin="0 2" />
					<Label Content="миллисекунд" />
				</StackPanel>

				<local:NumericUpDown MinValue="1" MaxValue="10" Value="{Binding PlaylistErrorCountInRowMax, Mode=TwoWay}" Width="60" Margin="0 2"
									 Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" />
				<local:NumericUpDown MinValue="1" MaxValue="10" Value="{Binding OtherErrorCountInRowMax, Mode=TwoWay}" Width="60" Margin="0 2"
									 Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" />
			</Grid>

			<GroupBox Header="Чанки" Margin="0 0 0 2">
				<WrapPanel Orientation="Horizontal">
					<CheckBox Content="Сохранять информацию о чанках" IsChecked="{Binding SaveChunkInfos}" Margin="4 0" />
					<CheckBox Content="Сохранять имя файла чанка" IsChecked="{Binding SaveChunkFileName}" Margin="4 0" />
					<CheckBox Content="Сохранять ссылку на чанк" IsChecked="{Binding SaveChunkFileUrl}" Margin="4 0" />
					<CheckBox Content="Время по GMT" IsChecked="{Binding UseGmtTime}" Margin="4 0" />
				</WrapPanel>
			</GroupBox>

			<CheckBox Content="Начинать дампинг сразу" IsChecked="{Binding StartDumpImmediately}" Margin="4 0" />

			<StackPanel Orientation="Horizontal" Margin="4">
				<Button Content="Добавить" Padding="6 2"
						Command="{Binding BtnAddStreamCommand}" />
				<Border Background="Yellow" BorderBrush="Red" BorderThickness="1" Margin="4 0 0 0">
					<Label Content="Внимание! После добавления стрима, изменить его параметры будет нельзя!" />
				</Border>
			</StackPanel>
		</StackPanel>

		<GroupBox Header="Стримы" Grid.Row="1">
			<ListView ItemsSource="{Binding StreamItems}"
					  SelectedItem="{Binding SelectedItem}"
					  local:AutoBindEvents.IsAutoBindEvent="True">
				<ListView.View>
					<GridView>
						<GridViewColumn Header="Название"
										Width="150" DisplayMemberBinding="{Binding Title}" />
						<GridViewColumn Header="Дампинг файл"
										Width="150" DisplayMemberBinding="{Binding OutputFilePath}" />
						<GridViewColumn Header="Размер файла"
										Width="100" DisplayMemberBinding="{Binding OutputFileSizeFormatted}" />
						<GridViewColumn Header="Новые чанки"
										Width="100" DisplayMemberBinding="{Binding NewChunkCountFormatted}" />
						<GridViewColumn Header="Задержка плейлиста"
										Width="140" DisplayMemberBinding="{Binding PlaylistDelayFormatted}" />
						<GridViewColumn Header="Обработка чанка"
										DisplayMemberBinding="{Binding ChunkProcessingTimeFormatted}" />
						<GridViewColumn Header="ID чанка" DisplayMemberBinding="{Binding ChunkIdFormatted}" />
						<GridViewColumn Header="Продолжительность чанка (секунды)" DisplayMemberBinding="{Binding ChunkLengthFormatted}" />
						<GridViewColumn Header="Размер чанка" DisplayMemberBinding="{Binding ChunkFileSizeFormatted}" />
						<GridViewColumn Header="Имя файла чанка" Width="200" DisplayMemberBinding="{Binding ChunkFileName}" />
						<GridViewColumn Header="Ссылка на чанк" Width="200" DisplayMemberBinding="{Binding ChunkUrl}" />
						<GridViewColumn Header="Первый чанк" DisplayMemberBinding="{Binding FirstChunkIdFormatted}" />
						<GridViewColumn Header="Обработано чанков" DisplayMemberBinding="{Binding ProcessedChunkCountFormatted}" />
						<GridViewColumn Header="Потеряно чанков" DisplayMemberBinding="{Binding LostChunkCountFormatted}" />
						<GridViewColumn Header="Дампинг начат"
										Width="150" DisplayMemberBinding="{Binding DumpStartedFormatted}" />
						<GridViewColumn Header="Состояние"
										Width="150" DisplayMemberBinding="{Binding State}" />
						<GridViewColumn Header="Ошибки плейлиста" DisplayMemberBinding="{Binding PlaylistErrorCountInRowFormatted}" />
						<GridViewColumn Header="Ошибки скачивания чанков" DisplayMemberBinding="{Binding ChunkDownloadErrorCountFormatted}" />
						<GridViewColumn Header="Ошибки объединения чанков" DisplayMemberBinding="{Binding ChunkAppendErrorCountFormatted}" />
						<GridViewColumn Header="Другие ошибки" DisplayMemberBinding="{Binding OtherErrorCountInRowFormatted}" />
						<GridViewColumn Header="Тип"
										Width="70" DisplayMemberBinding="{Binding Type}" />
						<GridViewColumn Header="Program ID" DisplayMemberBinding="{Binding ProgramIdFormatted}" />
						<GridViewColumn Header="Group ID"
										Width="100" DisplayMemberBinding="{Binding GroupId}" />
						<GridViewColumn Header="Format name" DisplayMemberBinding="{Binding FormatName}" />
						<GridViewColumn Header="Closed captions" DisplayMemberBinding="{Binding ClosedCaptions}" />
						<GridViewColumn Header="Bandwidth"
										Width="80" DisplayMemberBinding="{Binding BandwidthFormatted}" />
						<GridViewColumn Header="Видео"
										Width="90" DisplayMemberBinding="{Binding VideoResolution}" />
						<GridViewColumn Header="Кадров в секунду" DisplayMemberBinding="{Binding VideoFrameRateFormatted}" />
						<GridViewColumn Header="Кодеки"
										Width="150" DisplayMemberBinding="{Binding Codecs}" />
						<GridViewColumn Header="Язык"
										Width="80" DisplayMemberBinding="{Binding Language}" />
						<GridViewColumn Header="Ссылка на плейлист" Width="400" DisplayMemberBinding="{Binding PlaylistUrl}" />
					</GridView>
				</ListView.View>

				<ListView.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Проверить"
								  Command="{Binding StartDumpCommand}" />
						<MenuItem Header="Остановить"
								  Command="{Binding StopDumpCommand}" />
						<MenuItem Header="Удалить из списка"
								  Command="{Binding RemoveItemFromListCommand}" />
					</ContextMenu>
				</ListView.ContextMenu>
			</ListView>
		</GroupBox>
	</Grid>
</Window>
